---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('products')).filter(p => p.data.published).sort((a,b)=>a.data.order-b.data.order);
const by = (c: string) => all.filter(p => p.data.category === c);
const ld = { '@context':'https://schema.org','@type':'CollectionPage',name:'Books & Audio | Silent Power',
  hasPart: all.map(p => ({'@type':'Product',name:p.data.title,url:new URL(`/shop/${p.id}/`, Astro.site).href})) };
---
<Base title="Books & Audio" description="Taoist books, free guides, guided audio and music from Silent Power. Start with a free book or go straight to the main titles." jsonLd={ld}>
<section><div class="wrap">
  <div class="label">Books & Audio</div>
  <h1 style="font-size:clamp(2.4rem,6vw,4.4rem)">Everything in one quiet place.</h1>
  <p class="lede">Start with a free book, or go straight to the one that fits what you are carrying. Checkout opens right on the page, handled by Gumroad.</p>
</div></section>

<section class="band" id="books"><div class="wrap">
  <div class="label">English</div><h2>Books & Guides</h2>
  <div class="grid">{by('books').map(p => <ProductCard p={p} />)}</div>
</div></section>

<section id="audio"><div class="wrap">
  <div class="label">Listen</div><h2>Audio & Music</h2>
  <div class="grid">{by('audio').map(p => <ProductCard p={p} />)}</div>
</div></section>

<section class="band" id="hebrew" dir="rtl" lang="he"><div class="wrap">
  <div class="label">עברית</div><h2>מהדורות בעברית</h2>
  <div class="grid">{by('hebrew').map(p => <ProductCard p={p} />)}</div>
</div></section>
</Base>
