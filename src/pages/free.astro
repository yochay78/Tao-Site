---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Optin from '../components/Optin.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('products')).filter(p => p.data.published).sort((a,b)=>a.data.order-b.data.order);
const items = all.filter(p => p.data.language === 'en' && (p.data.priceLabel === 'Free'));
const desc = 'Free short books on the Tao Te Ching from Silent Power: Practicing Eternity, Stop Pushing So Hard, When Your Mind Won\'t Slow Down, and the nine guided audios. Short, plain English, a gentle place to begin.';
const url = 'https://silentpower.me/free/';
const ld = [
  { '@context':'https://schema.org','@type':'CollectionPage', '@id': url + '#page', url, name:'Free Tao Te Ching Books and Guides', description: desc, inLanguage:'en',
    isPartOf: { '@type':'WebSite', name:'Silent Power', url:'https://silentpower.me/' },
    about: { '@type':'Book', name:'Tao Te Ching', author: { '@type':'Person', name:'Lao Tzu' } },
    mainEntity: { '@type':'ItemList', numberOfItems: items.length, itemListElement: items.map((p, i) => ({ '@type':'ListItem', position: i + 1, url: new URL(`/shop/${p.id}/`, Astro.site).href, name: p.data.title })) } },
  { '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement: [{ '@type':'ListItem', position:1, name:'Home', item:'https://silentpower.me/' },{ '@type':'ListItem', position:2, name:'Free Books', item: url }] },
];
---
<Base alt="/he/free/" title="Free Tao Te Ching Books and Guides" description={desc} jsonLd={ld}>
<section><div class="wrap">
  <div class="label">Free</div>
  <h1 style="font-size:clamp(2.4rem,6vw,4.4rem)">Start here.</h1>
  <p class="lede">Short, free, and meant to be used the same day. Open the page, enter 0 as the price if Gumroad asks, and it is yours. No card needed.</p>
  <div class="grid" style="margin-top:36px">{items.map(p => <ProductCard p={p} />)}</div>
</div></section>
<section class="band"><div class="wrap">
  <div class="label">Not sure which?</div>
  <h2>If your mind is loud, begin with <em style="color:var(--gold);font-style:normal">When Your Mind Won't Slow Down</em>.</h2>
  <p class="lede">If you push too hard, begin with <strong>Stop Pushing So Hard</strong>. Each takes about ten minutes. When you want more, the main books are on the <a href="/shop/">shop page</a>.</p>
</div></section>
<Optin />
</Base>
