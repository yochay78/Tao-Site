---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){
  const items = (await getCollection('products')).filter(p=>p.data.kind==='book');
  return items.map(p=>({params:{slug:p.id},props:{p}}));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const buyable = d.status==='published' && d.gumroadUrl;
const ld = { '@context':'https://schema.org','@type':'Book',name:d.title,author:{'@type':'Person',name:'Yod Mem'},publisher:{'@type':'Organization',name:'Silent Power'},inLanguage:'en',
  ...(buyable ? {offers:{'@type':'Offer',url:d.gumroadUrl,availability:'https://schema.org/InStock',price:d.priceLabel.replace('$',''),priceCurrency:'USD'}} : {}) };
---
<Base title={d.title} description={d.cardNote} type="book" jsonLd={ld}>
<section><div class="wrap" style="display:grid;gap:48px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
<div class="cover" style="max-width:320px;width:100%;margin:0 auto">{d.imageLarge ? <img src={d.imageLarge} alt={`Cover of ${d.title}`} width="1200" height="1600" /> : <><span class="c">守</span><span class="t">{d.title}</span><span class="a">Yod Mem · Silent Power</span></>}</div>
<div class="prose"><div class="label">{d.subtitle}</div><h1 style="font-size:clamp(2rem,5vw,3.2rem)">{d.title}</h1>
<p class="note sans">{d.pages} · by Yod Mem</p>
<Content />
{buyable && <p class="price" style="font-size:1.4rem">{d.priceLabel}</p>}
{buyable && <p><a class="btn" href={d.gumroadUrl} rel="noopener" data-track="buy_click" data-item={p.id}>Buy now</a></p>}
{d.amazonUrl && <p><a href={d.amazonUrl} rel="noopener" data-track="amazon_click" data-item={p.id}>Also on Amazon →</a></p>}
<p class="note">Checkout and delivery are handled securely by Gumroad.</p></div>
</div></section>
</Base>
