---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { articleLd } from '../../data/journal-ld';
import { chapterNums } from '../../data/chapter-links';
export async function getStaticPaths(){
  return (await getCollection('journal')).map(p=>({params:{slug:p.id},props:{p}}));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const prods = (await getCollection('products')).filter(x=>x.data.language==='en');
const map: Record<string,string> = { still:'mind-wont-slow-down', unshakable:'becoming-unshakable', root:'the-root' };
const target = prods.find(x => x.id === (map[d.cta] ?? d.cta)) ?? prods.find(x => x.id === 'stop-pushing')!;
const ctaTitle = target.data.title + (target.data.priceLabel === 'Free' ? ' (free)' : '');
const ctaHref = `/shop/${target.id}/`;
const heIds = new Set((await getCollection('journalHe')).map(x => x.id));
const alt = heIds.has(p.id) ? `/he/journal/${p.id}/` : undefined;
const ld = articleLd({ title: d.title, description: d.description, date: d.date, url: `https://silentpower.me/journal/${p.id}/`, lang: 'en', section: d.chapter, faq: d.faq });
const chs = chapterNums(d.chapter);
const terms = (await getCollection('glossary')).filter(t => t.data.journal.includes(p.id)).sort((a, b) => a.data.order - b.data.order);
const dateLabel = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.description} type="article" jsonLd={ld} alt={alt} published={d.date}>
<article><section><div class="wrap narrow prose">
<div class="label">{d.chapter}</div><h1 style="font-size:clamp(2rem,5vw,3.2rem)">{d.title}</h1>
<p class="sans" style="opacity:.7;margin-top:-8px"><time datetime={d.date.toISOString().slice(0,10)}>{dateLabel}</time></p>
<Content />
{d.faq?.length && <section class="faq" aria-labelledby="faq-h"><h2 id="faq-h">Common questions</h2>{d.faq.map(f => <><h3>{f.q}</h3><p>{f.a}</p></>)}</section>}
{terms.length > 0 && <p class="sans">Key terms in this article: {terms.map((t,i) => <>{i>0 && ' · '}<a href={`/glossary/${t.id}/`}>{t.data.term}</a></>)}</p>}
{chs.length > 0 && <p class="sans">Read the full chapters: {chs.map((n,i) => <>{i>0 && ' · '}<a href={`/tao/${n}/`}>Chapter {n}</a></>)}</p>}
<hr class="rule" style="margin:40px 0">
<p class="sans"><a class="btn" href={ctaHref} data-track="article_cta" data-item={d.cta}>{ctaTitle} →</a></p>
<p class="sans" style="margin-top:24px"><a href="/journal/">← More from the Journal</a> · <a href="/tao/">Read all 81 chapters</a></p>
</div></section></article>
</Base>
