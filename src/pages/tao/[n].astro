---
import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import SocialVideo from '../../components/SocialVideo.astro';
import TaoSlides from '../../components/TaoSlides.astro';
import { tao, TOTAL } from '../../data/tao';
import { notes } from '../../data/tao-notes';
import { notesHe } from '../../data/tao-notes-he';
import { videos } from '../../data/tao-videos';
import { social } from '../../data/tao-social';
export function getStaticPaths() { return tao.map(c => ({ params: { n: String(c.n) } })); }
const n = Number(Astro.params.n);
const c = tao.find(x => x.n === n)!;
const note = notes[n];
const vid = note?.video ?? videos[n];
const soc = social[n]?.en;
const first = c.en.split('\n')[0];
const stanzas = c.en.split(/\n\s*\n/);
const url = `https://silentpower.me/tao/${n}/`;
const h1 = note ? `Tao Te Ching Chapter ${n}: ${note.title}` : '';
const prev = notes[n - 1] ? { n: n - 1, t: notes[n - 1].title } : null;
const next = notes[n + 1] ? { n: n + 1, t: notes[n + 1].title } : null;
const alt = notesHe[n] ? `/he/tao/${n}/` : undefined;
const ld = note ? [
  { '@context':'https://schema.org','@type':'Article', headline: h1, description: note.description, inLanguage:'en', url, mainEntityOfPage: url, datePublished:'2026-11-04', dateModified:'2026-11-11', author:{ '@id':'https://silentpower.me/#person' }, publisher:{ '@id':'https://silentpower.me/#org' }, about:{ '@type':'CreativeWork', name:`Tao Te Ching, chapter ${n}`, isPartOf:{ '@type':'Book', name:'Tao Te Ching', author:{ '@type':'Person', name:'Lao Tzu' }, sameAs:'https://en.wikipedia.org/wiki/Tao_Te_Ching' } }, speakable:{ '@type':'SpeakableSpecification', cssSelector:['h1','.lede'] }, ...(alt ? { workTranslation: { '@type':'Article', inLanguage:'he', url:`https://silentpower.me/he/tao/${n}/` } } : {}) },
  { '@context':'https://schema.org','@type':'FAQPage', inLanguage:'en', mainEntity: note.faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) },
  { '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Silent Power', item:'https://silentpower.me/' },
    { '@type':'ListItem', position:2, name:'Tao Te Ching', item:'https://silentpower.me/tao/' },
    { '@type':'ListItem', position:3, name:`Chapter ${n}`, item:url } ] },
  ...(vid ? [{ '@context':'https://schema.org','@type':'VideoObject', name: vid.title, description: `${vid.title}. A short video on Tao Te Ching chapter ${n} from the Silent Power channel.`, thumbnailUrl:`https://i.ytimg.com/vi/${vid.id}/hqdefault.jpg`, uploadDate: (note.video?.uploaded ?? '2026-11-04'), ...(note.video ? { duration: note.video.duration } : {}), embedUrl:`https://www.youtube-nocookie.com/embed/${vid.id}`, contentUrl:`https://www.youtube.com/watch?v=${vid.id}` }] : []),
] : undefined;
const watchTitle = vid?.title ?? (note ? note.title : '');
---
{note ? (
<Base title={h1} description={note.description} type="article" jsonLd={ld} alt={alt}>
<TaoSlides n={n} lang="en" />
<article><section><div class="wrap narrow prose">
<div class="label">Tao Te Ching · Chapter {n} of {TOTAL}</div>
<h1 style="font-size:clamp(2rem,5vw,3.2rem)">{h1}</h1>
<p class="lede">{note.intro}</p>
<h2>The full chapter</h2>
{stanzas.map(s => <p>{s.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>)}
<h2>What it means</h2>
{note.body.map(p => <p>{p}</p>)}
{(vid || soc?.ig) && <h2>Watch</h2>}
{vid && <VideoCard id={vid.id} title={vid.title} />}
{!vid && soc?.ig && <SocialVideo ig={soc.ig} fb={soc.fb} tt={soc.tt} title={`Tao Te Ching chapter ${n}: ${note.title}`} />}
{vid && (soc?.ig || soc?.fb || soc?.tt) && <SocialVideo fb={soc.fb} tt={soc.tt} ig={undefined} title={vid.title} />}
<h2>Questions</h2>
{note.faq.map(([q, a]) => <><h3>{q}</h3><p>{a}</p></>)}
<hr class="rule" style="margin:40px 0">
<nav class="chnav sans" aria-label="Chapters">
  {prev ? <a href={`/tao/${prev.n}/`} rel="prev">← Chapter {prev.n}: {prev.t}</a> : <span></span>}
  {next && <a href={`/tao/${next.n}/`} rel="next">Chapter {next.n}: {next.t} →</a>}
</nav>
<p class="sans" style="margin-top:18px"><a href="/tao/">All chapters</a>{alt && <> · <a href={alt} hreflang="he" lang="he">עברית</a></>} · <a href="/free/">Start with a free book</a> · <a href="/journal/">Read the journal</a></p>
</div></section></article>
</Base>
) : (
<Base noindex title={`${c.n}. Tao Te Ching, chapter ${c.n}`} description={first + ' ...'}>
<TaoSlides n={n} lang="en" />
{(vid || soc?.ig) && <section><div class="wrap narrow"><h2 style="font-size:1.3rem">Watch</h2>
{vid ? <VideoCard id={vid.id} title={vid.title} /> : <SocialVideo ig={soc?.ig} fb={soc?.fb} tt={soc?.tt} title={`Tao Te Ching chapter ${n}`} />}
</div></section>}
</Base>
)}
