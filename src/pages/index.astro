---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import ProductCard from '../components/ProductCard.astro';
import Optin from '../components/Optin.astro';
import { getCollection } from 'astro:content';
import { videos, site } from '../data/site';
const products = (await getCollection('products')).filter(p => p.data.published && p.data.language==='en').sort((a,b)=>a.data.order-b.data.order);
const get = (id: string) => products.find(p => p.id === id)!;
const featured = products.filter(p => p.data.featured);
const free = ['stop-pushing','mind-wont-slow-down'].map(get);
const audio = ['sound-of-the-tao','root-audio'].map(get);
const articles = (await getCollection('journal')).sort((a,b)=>+b.data.date-+a.data.date).slice(0,3);
const ld = [{ '@context':'https://schema.org','@type':'WebSite',name:'Silent Power',url:Astro.site?.href },
  { '@context':'https://schema.org','@type':'Person',name:site.author,url:Astro.site?.href,sameAs:[site.youtubeChannel,site.instagram,site.tiktok,site.facebook] }];
---
<Base alt="/he/" title="Silent Power" description="There is a secret in the oldest book on strength. Taoist books, free reading, music and videos from Silent Power." jsonLd={ld}>
<section class="hero"><div class="wrap">
  <div class="label">3,000 years old. Still unspoken.</div>
  <h1 style="margin-top:.3em">There is a <em>secret</em><br>in the oldest<br>book on strength.</h1>
  <div class="heroRow">
    <p class="sub">Not about pushing harder.<br>Hidden in plain sight.</p>
    <div class="heroBtns">
      <a class="btn" href="/shop/" data-track="hero_explore">Explore the Books</a>
      <a class="link-soft" href="/free/" data-track="hero_free">Start for Free</a>
    </div>
  </div>
  <div class="covers">
    <img class="c1" src={get('stop-pushing').data.cover} alt="Cover of Stop Pushing So Hard" width="1200" height="1600">
    <img class="c2" src={get('becoming-unshakable').data.cover} alt="Cover of The Taoist Secret to Becoming Unshakable" width="1200" height="1600">
    <img class="c3" src={get('the-root').data.cover} alt="Cover of The Taoist Secret of the Root" width="1200" height="1600">
    <img class="c4" src={get('mind-wont-slow-down').data.cover} alt="Cover of When Your Mind Won't Slow Down" width="1200" height="1600">
  </div>
</div></section>

<section class="band"><div class="wrap">
  <div class="label">A first taste</div>
  <h2>Begin with a free book</h2>
  <p class="lede">Two short books, about ten minutes each. Nothing to pay.</p>
  <div class="grid">{free.map(p => <ProductCard p={p} />)}</div>
</div></section>

<section><div class="wrap">
  <div class="label">Two doors</div>
  <h2>Into the same secret</h2>
  <div class="grid">{featured.map(p => <ProductCard p={p} />)}</div>
</div></section>

<section class="band"><div class="wrap">
  <div class="steps">
    <div><div class="n">01</div><div class="t">Not what you think.</div><p>Strength points the other way.</p></div>
    <div><div class="n">02</div><div class="t">One page. One idea.</div><p>Simple to say. Harder to live.</p></div>
    <div><div class="n">03</div><div class="t">Once seen, never unseen.</div><p>The loud world loosens its grip.</p></div>
  </div>
</div></section>

<section><div class="wrap"><div class="label">Watch</div><h2>Selected videos</h2>
  <div class="grid">{videos.slice(0,3).map(v => <VideoCard {...v} />)}</div>
  <p style="margin-top:28px"><a href="/watch/">More videos →</a></p></div></section>

<section class="band"><div class="wrap"><div class="label">The Tao Journal</div><h2>Short essays on the Tao Te Ching</h2>
  <div class="grid">{articles.map(a => <a class="card" href={`/journal/${a.id}/`} style="text-decoration:none"><h3>{a.data.title}</h3><p>{a.data.description}</p></a>)}</div></div></section>

<section><div class="wrap"><div class="label">Listen</div><h2>Audio & music</h2>
  <div class="grid">{audio.map(p => <ProductCard p={p} />)}</div></div></section>

<section class="band"><div class="wrap narrow">
  <div class="label">Who is behind this</div>
  <h2>Hello, I am Yod Mem.</h2>
  <p class="lede">Silent Power is a small independent project. I make books, music and videos that try to make the Tao Te Ching clear without making it shallow. <a href="/about/">More about the project →</a></p>
</div></section>

<Optin />
</Base>
