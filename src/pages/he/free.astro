---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Optin from '../../components/Optin.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('products')).filter(p => p.data.published && p.data.language === 'he' && p.data.priceLabel === 'חינם');
const desc = 'מדריך חינמי בעברית על הטאו טה צ\'ינג: תפסיק לדחוף כל כך חזק. קריאה קצרה ופשוטה, מקום עדין להתחיל בו.';
const url = 'https://silentpower.me/he/free/';
const ld = [
  { '@context':'https://schema.org','@type':'CollectionPage', '@id': url + '#page', url, name:'ספרים חינמיים על הטאו טה צ\'ינג', description: desc, inLanguage:'he',
    isPartOf: { '@type':'WebSite', name:'Silent Power', url:'https://silentpower.me/' },
    about: { '@type':'Book', name:'Tao Te Ching', author: { '@type':'Person', name:'Lao Tzu' } },
    mainEntity: { '@type':'ItemList', numberOfItems: items.length, itemListElement: items.map((p, i) => ({ '@type':'ListItem', position: i + 1, url: new URL(`/he/shop/${p.id}/`, Astro.site).href, name: p.data.title })) } },
  { '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement: [{ '@type':'ListItem', position:1, name:'דף הבית', item:'https://silentpower.me/he/' },{ '@type':'ListItem', position:2, name:'להתחיל בחינם', item: url }] },
];
---
<Base lang="he" alt="/free/" title="להתחיל בחינם: מדריך חינמי על הטאו טה צ'ינג" description={desc} jsonLd={ld}>
<section><div class="wrap">
  <div class="label">חינם</div>
  <h1 style="font-size:clamp(2.2rem,6vw,4rem)">מתחילים כאן.</h1>
  <p class="lede">קצר, חינמי, ומיועד לשימוש באותו יום. פותחים את העמוד, מזינים 0 כמחיר אם Gumroad מבקש, וזה שלכם. בלי כרטיס אשראי.</p>
  <div class="grid" style="margin-top:36px">{items.map(p => <ProductCard p={p} />)}</div>
</div></section>
<section class="band"><div class="wrap">
  <p class="lede">כשתרצו עוד, הספר המלא נמצא ב<a href="/he/shop/">עמוד הספרים</a>.</p>
</div></section>
<Optin he />
</Base>
