---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { glossaryTermLd } from '../../../data/glossary-ld';
import { notesHe } from '../../../data/tao-notes-he';
export async function getStaticPaths() {
  return (await getCollection('glossaryHe')).map(p => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const all = await getCollection('glossaryHe');
const enIds = new Set((await getCollection('glossary')).map(x => x.id));
const alt = enIds.has(p.id) ? `/glossary/${p.id}/` : undefined;
const related = d.related.map(id => all.find(x => x.id === id)).filter(Boolean) as typeof all;
const journal = (await getCollection('journalHe')).filter(j => d.journal.includes(j.id));
const ld = glossaryTermLd({ lang: 'he', id: p.id, term: d.term, aka: d.aka, title: d.title, description: d.description, short: d.short, updated: d.updated, faq: d.faq });
---
<Base lang="he" title={d.title} description={d.description} type="article" jsonLd={ld} alt={alt}>
<article dir="rtl"><section><div class="wrap narrow prose">
<div class="label"><a href="/he/glossary/">מילון הטאו</a>{d.aka && <> · {d.aka}</>}</div>
<h1 style="font-size:clamp(2rem,5vw,3.2rem)">{d.title}</h1>
<p class="lede">{d.short}</p>
<Content />
{d.chapters.length > 0 && <><h2>איפה זה מופיע בטאו טה צ'ינג</h2><ul class="sans">{d.chapters.map(n => <li><a href={`/he/tao/${n}/`}>פרק {n}{notesHe[n] ? `: ${notesHe[n].title}` : ''}</a></li>)}</ul></>}
{d.faq?.length && <section class="faq" aria-labelledby="faq-h"><h2 id="faq-h">שאלות נפוצות</h2>{d.faq.map(f => <><h3>{f.q}</h3><p>{f.a}</p></>)}</section>}
{(related.length > 0 || journal.length > 0) && <h2>להמשיך לקרוא</h2>}
{related.length > 0 && <p class="sans">מושגים קשורים: {related.map((r, i) => <>{i > 0 && ' · '}<a href={`/he/glossary/${r.id}/`}>{r.data.term}</a></>)}</p>}
{journal.length > 0 && <ul class="sans">{journal.map(j => <li><a href={`/he/journal/${j.id}/`}>{j.data.title}</a></li>)}</ul>}
<hr class="rule" style="margin:40px 0">
<p class="sans"><a href="/he/glossary/">כל המושגים →</a> · <a href="/he/tao/">לכל 81 הפרקים</a> · <a href="/he/free/">להתחיל בחינם</a></p>
</div></section></article>
</Base>
