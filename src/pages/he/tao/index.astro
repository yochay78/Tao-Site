---
import Base from '../../../layouts/Base.astro';
import { tao, TOTAL } from '../../../data/tao';
import { notes } from '../../../data/tao-notes';
import { notesHe } from '../../../data/tao-notes-he';
const have = new Set(tao.map(c => c.n));
const list = Object.entries(notesHe).sort((a, b) => Number(a[0]) - Number(b[0]));
const desc = "כל 81 פרקי הטאו טה צ'ינג בתרגום עברי שקט ומהודק, ולכל פרק הסבר פשוט, סרטון קצר ותשובות לשאלות הנפוצות.";
const ld = list.length ? [
  { '@context':'https://schema.org','@type':'CollectionPage', name:"הטאו טה צ'ינג: כל 81 הפרקים", description:desc, inLanguage:'he', url:'https://silentpower.me/he/tao/', isPartOf:{ '@id':'https://silentpower.me/#website' }, about:{ '@type':'Book', name:'Tao Te Ching', author:{ '@type':'Person', name:'Laozi' } }, mainEntity:{ '@type':'ItemList', numberOfItems:list.length, itemListElement: list.map(([k, v], i) => ({ '@type':'ListItem', position:i+1, url:`https://silentpower.me/he/tao/${k}/`, name:`פרק ${k}: ${v.title}` })) } },
  { '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement:[ { '@type':'ListItem', position:1, name:'בית', item:'https://silentpower.me/he/' }, { '@type':'ListItem', position:2, name:"טאו טה צ'ינג", item:'https://silentpower.me/he/tao/' } ] },
] : undefined;
---
<Base lang="he" noindex={!list.length} title="הטאו טה צ'ינג בעברית: כל 81 הפרקים, עם הסבר פשוט" description={desc} jsonLd={ld} alt={Object.keys(notes).length ? '/tao/' : undefined}>
<section dir="rtl"><div class="wrap">
  <div class="label">טאו טה צ'ינג</div>
  <h1 style="font-size:clamp(2.2rem,6vw,4rem)">פרק אחרי פרק.</h1>
  <p class="lede">שמונים ואחד פרקים קצרים. לכל פרק: הטקסט המלא, הסבר פשוט, סרטון קצר ותשובות לשאלות הנפוצות. המושגים המרכזיים מוסברים ב<a href="/he/glossary/">מילון הטאואיזם</a>, וה<a href="/he/journal/">יומן</a> מביא אותם לחיי היומיום.</p>
  {list.length > 0 && <ol class="chlist prose" style="margin-top:24px;list-style:none;padding:0">{list.map(([k, v]) => <li><a href={`/he/tao/${k}/`}>פרק {k}: {v.title}</a></li>)}</ol>}
  <h2 style="margin-top:40px;font-size:1.3rem">קפיצה לפרק</h2>
  <div class="taogrid">{Array.from({length: TOTAL}, (_, i) => i + 1).map(n => have.has(n) ? <a href={`/he/tao/${n}/`}>{n}</a> : <span class="off">{n}</span>)}</div>
</div></section>
</Base>
