---
import Base from '../../../layouts/Base.astro';
import LCard from '../../../components/LCard.astro';
import { getCollection } from 'astro:content';
import { i18n } from '../../../data/i18n';
export async function getStaticPaths() {
  const all = await getCollection('products');
  return Object.keys(i18n).flatMap(lang => ['becoming-unshakable','stop-pushing'].map(slug => ({
    params: { lang, slug }, props: { p: all.find(x => x.id === slug)!, other: all.find(x => x.id === (slug === 'stop-pushing' ? 'becoming-unshakable' : 'stop-pushing'))! } })));
}
const { lang, slug } = Astro.params as { lang: string; slug: string };
const { p, other } = Astro.props;
const L = i18n[lang]; const t = L.products[slug]; const P = L.prod;
const free = slug === 'stop-pushing';
const buy = free ? P.buyFree : P.buy;
const priceText = free ? P.free : t.price;
const img = new URL(p.data.cover, Astro.site).href;
const ld = { '@context':'https://schema.org','@type':'Product',name:t.title,description:t.short,image:img,brand:{'@type':'Brand',name:'Silent Power'},author:{'@type':'Person',name:'Yod Mem'},inLanguage:'en',
  offers:{'@type':'Offer',price:free?'0':'19',priceCurrency:'USD',url:p.data.gumroadUrl,availability:'https://schema.org/InStock'} };
---
<Base lang={lang} alt={`/shop/${slug}/`} title={t.title} description={t.short} type="product" jsonLd={ld} ogImage={p.data.cover}>
<meta name="x-product" content={`${slug}-${lang}`} slot="head" />
<article lang={L.htmlLang}>
<section class="phero"><div class="wrap pgrid">
  <div class="pimg tall"><img src={p.data.cover} alt={`${P.cover} ${t.title}`} width="1200" height="1600"></div>
  <div class="pinfo">
    <a class="label" href={`/${lang}/shop/`} style="text-decoration:none">← {P.back}</a>
    <h1 style="font-size:clamp(2rem,5vw,3.4rem);margin-top:.4em">{t.title}</h1>
    <p class="lede">{t.headline}</p>
    <div class="buyrow"><span class="bigprice">{priceText}</span>
      <a class="btn" href={p.data.gumroadUrl} rel="noopener" data-track={free ? 'free_click' : 'buy_click'} data-item={`${slug}-${lang}`}>{buy}</a></div>
    <p class="ennote">{P.enNote}</p>
    <p class="note">{P.via}</p>
    <p class="note">{t.format}</p>
  </div>
</div></section>
<section class="band"><div class="wrap narrow prose">{t.body.map(x => <p>{x}</p>)}</div></section>
<section><div class="wrap narrow prose">
  <h2>{P.explores}</h2><ul>{t.explores.map(x => <li>{x}</li>)}</ul>
  <h2>{P.who}</h2><p>{t.whoFor}</p>
  <h2>{P.notfor}</h2><p>{t.notFor}</p>
  <h2>{P.exp}</h2><ul>{t.experience.map(x => <li>{x}</li>)}</ul>
  <h2>{P.inc}</h2><ul>{t.included.map(x => <li>{x}</li>)}</ul>
  <p style="margin-top:36px"><a class="btn" href={p.data.gumroadUrl} rel="noopener" data-track={free ? 'free_click' : 'buy_click'} data-item={`${slug}-${lang}`}>{buy}</a></p>
  <p class="note">{P.via}</p>
</div></section>
<section class="band"><div class="wrap"><h2>{P.rel}</h2>
  <div class="grid"><LCard lang={lang} id={other.id} p={other} /></div></div></section>
</article>
</Base>
