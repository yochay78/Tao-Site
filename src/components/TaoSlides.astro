---
import { tao, TOTAL } from '../data/tao';
const { n, lang } = Astro.props as { n: number; lang: 'en' | 'he' };
const he = lang === 'he';
const c = tao.find(x => x.n === n)!;
const slides = (he ? c.he : c.en).split(/\n\s*\n/).map(s => s.trim().split('\n'));
const base = he ? '/he/tao/' : '/tao/';
const prev = tao.find(x => x.n === n - 1) ? `${base}${n - 1}/#last` : base;
const next = tao.find(x => x.n === n + 1) ? `${base}${n + 1}/` : base;
const t = he ? { ch: 'פרק', all: 'כל הפרקים', share: 'שיתוף', prev: 'הקודם', next: 'הבא' } : { ch: 'Chapter', all: 'All chapters', share: 'Share', prev: 'Previous', next: 'Next' };
---
<section class="taoview" dir={he ? 'rtl' : undefined} lang={he ? 'he' : 'en'} data-prev={prev} data-next={next} data-rtl={he ? '1' : '0'}>
  <div class="taobar"><a href={base} class="label" style="text-decoration:none">{t.all}</a><span class="label">{t.ch} {n} / {TOTAL}</span></div>
  <div class="slides">
    {slides.map((lines, i) => (
      <div class={`slide${i === 0 ? ' on' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
        <p class="tl">{lines.map(l => <span>{l}</span>)}</p>
      </div>
    ))}
  </div>
  <div class="taoctl">
    <button type="button" class="tb prev" aria-label={t.prev}>{he ? '→' : '←'}</button>
    <div class="dots">{slides.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</div>
    <button type="button" class="tb next" aria-label={t.next}>{he ? '←' : '→'}</button>
  </div>
  <p class="note" style="text-align:center;margin-top:18px"><button type="button" class="link-soft sharebtn" style="background:none;border:0;color:inherit;cursor:pointer" data-track="tao_share">{t.share}</button></p>
</section>
<script is:inline>
(function(){var r=document.querySelector('.taoview');if(!r)return;var s=[].slice.call(r.querySelectorAll('.slide')),d=[].slice.call(r.querySelectorAll('.dots i')),i=0,rtl=r.dataset.rtl==='1';
function show(k){i=k;s.forEach(function(e,j){e.classList.toggle('on',j===k);e.setAttribute('aria-hidden',j===k?'false':'true')});d.forEach(function(e,j){e.classList.toggle('on',j===k)});history.replaceState(null,'','#'+(k+1));if(typeof gtag==='function')gtag('event','tao_slide',{page:location.pathname,slide:k+1});}
function go(dir){var k=i+dir;if(k<0){location.href=r.dataset.prev;return}if(k>=s.length){location.href=r.dataset.next;return}show(k)}
r.querySelector('.next').addEventListener('click',function(){go(1)});r.querySelector('.prev').addEventListener('click',function(){go(-1)});
document.addEventListener('keydown',function(e){if(e.key==='ArrowRight')go(rtl?-1:1);else if(e.key==='ArrowLeft')go(rtl?1:-1);else if(e.key===' '||e.key==='PageDown'){e.preventDefault();go(1)}else if(e.key==='PageUp')go(-1)});
var x0=null;r.addEventListener('touchstart',function(e){x0=e.changedTouches[0].clientX},{passive:true});r.addEventListener('touchend',function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;x0=null;if(Math.abs(dx)<40)return;var fwd=rtl?dx>0:dx<0;go(fwd?1:-1)});
var h=location.hash;if(h==='#last')show(s.length-1);else if(/^#\d+$/.test(h)){var k=parseInt(h.slice(1),10)-1;if(k>=0&&k<s.length)show(k)}
var sb=r.querySelector('.sharebtn');sb.addEventListener('click',function(){var u=location.origin+location.pathname;if(navigator.share){navigator.share({title:document.title,url:u}).catch(function(){})}else if(navigator.clipboard){navigator.clipboard.writeText(u);sb.textContent=sb.textContent+' ✓'}});})();
</script>
