---
import { site } from '../data/site';
const f = site.gumroadFollow;
import { i18n } from '../data/i18n';
const { he = false, lang = '' } = Astro.props;
const T = i18n[lang]?.optin;
const L = i18n[lang];
---
{f && (
<section class="optin" dir={he ? 'rtl' : undefined} lang={L ? L.htmlLang : he ? 'he' : undefined}><div class="wrap narrow">
<div class="label">{T ? T.label : he ? 'להישאר בשקט' : 'Stay in the quiet'}</div>
<h2>{T ? T.h2 : he ? 'הערות מעת לעת על הטאו.' : 'Occasional notes on the Tao.'}</h2>
<p>{T ? T.p : he ? 'מיילים קצרים, בלי רעש. אפשר להסיר בכל עת.' : 'Short emails, no noise. Unsubscribe any time.'}</p>
<form class="followform" action={f.action} method="post" target="_blank" >
  <input type="hidden" name="seller_id" value={f.sellerId} />
  <label class="sr" for="follow-email">{T ? T.email : he ? 'כתובת מייל' : 'Email address'}</label>
  <input id="follow-email" type="email" name="email" placeholder={T ? T.placeholder : he ? 'כתובת המייל שלך' : 'Your email address'} required autocomplete="email" />
  <button class="btn" type="submit">{T ? T.button : he ? 'להרשמה' : 'Subscribe'}</button>
</form>
<p class="note" style="margin-top:18px">{T ? <>{T.note1}<a href="/privacy/">{T.note2}</a>{T.note3}</> : he ? <>המיילים נשלחים דרך Gumroad. ראו את <a href="/privacy/">עמוד הפרטיות</a> (באנגלית).</> : <>Emails are sent through Gumroad. See the <a href="/privacy/">privacy page</a>.</>}</p>
</div></section>
)}
