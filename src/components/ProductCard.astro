---
const { p } = Astro.props;
const d = p.data;
const href = d.kind==='book' ? `/books/${p.id}/` : (d.gumroadUrl ?? '#');
const buyable = d.status==='published' && d.gumroadUrl;
const glyph = d.kind==='music' ? '音' : d.kind==='free' ? '道' : '守';
---
<article class="card">
  <div class="cover" role="img" aria-label={`Cover placeholder for ${d.title}`}>
    {d.image ? <img src={d.image} alt={d.title} loading="lazy" /> : <>
    <span class="c">{glyph}</span><span class="t">{d.title}</span><span class="a">Yod Mem · Silent Power</span></>}
  </div>
  <h3>{d.title}</h3>
  <p>{d.cardNote}</p>
  <div class="price">{d.status==='published' ? d.priceLabel : 'Coming soon'}{d.pages ? ` · ${d.pages}` : ''}</div>
  {d.status==='published' && (d.kind==='book'
    ? <a class="btn ghost" href={href}>Read more</a>
    : <a class="btn" href={d.gumroadUrl} rel="noopener" data-gumroad-overlay-checkout="true" data-track={d.kind==='free'?'free_book_click':'buy_click'} data-item={p.id}>{d.kind==='free'?'Get it free':'Buy now'}</a>)}
</article>
